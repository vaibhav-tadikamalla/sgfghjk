NODE_ENV=development
PORT=3001

# ── PostgreSQL ─────────────────────────────────
# docker compose up -d  →  exposes PG on :5433
DATABASE_URL=postgresql://collab:collab@localhost:5433/collab
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── JWT (RS256) ────────────────────────────────
# Generate with:  node scripts/generate-keys.mjs
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_KEY_HERE\n-----END PUBLIC KEY-----"

# ── Cookie Secret ──────────────────────────────
COOKIE_SECRET=local-dev-cookie-secret

# ── App ────────────────────────────────────────
APP_URL=http://localhost:5173
