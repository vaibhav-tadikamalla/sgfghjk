    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(peergrid_active_rooms)", "refId": "A"}],
      "title": "Rooms",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(rate(peergrid_stream_messages_published_total[1m]))", "refId": "A"}],
      "title": "CRDT Updates/sec",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(rate(peergrid_edge_mirror_lag_ms_sum[5m])) / clamp_min(sum(rate(peergrid_edge_mirror_lag_ms_count[5m])), 1)", "refId": "A"}],
      "title": "Mirror Lag (avg ms)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "targets": [
        {"expr": "avg(peergrid_event_loop_lag_ms)", "legendFormat": "event-loop lag", "refId": "A"},
        {"expr": "avg(peergrid_stream_consumer_lag)", "legendFormat": "stream lag", "refId": "B"}
      ],
      "title": "Stream / Event Loop Lag",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "targets": [
        {"expr": "sum(process_resident_memory_bytes)", "legendFormat": "RSS", "refId": "A"},
        {"expr": "sum(nodejs_heap_size_used_bytes)", "legendFormat": "heap used", "refId": "B"},
        {"expr": "sum(peergrid_total_room_memory_bytes)", "legendFormat": "room memory", "refId": "C"}
      ],
      "title": "Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 7,
      "targets": [
        {"expr": "sum(rate(peergrid_reconnect_attempts_total[1m]))", "legendFormat": "attempts/s", "refId": "A"},
        {"expr": "sum(rate(peergrid_reconnect_limited_total[1m]))", "legendFormat": "limited/s", "refId": "B"},
        {"expr": "sum(peergrid_reconnect_queue_depth)", "legendFormat": "queue depth", "refId": "C"}
      ],
      "title": "Reconnect Storms",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 8,
      "targets": [
        {"expr": "100 * sum(rate(process_cpu_user_seconds_total[1m]) + rate(process_cpu_system_seconds_total[1m]))", "legendFormat": "CPU % (sum)", "refId": "A"}
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    }
